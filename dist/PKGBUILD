pkgname=nightwave-plaza
pkgver="$(sed -n 's/^version *= *"\([^"]*\)".*/\1/p' "$startdir/../Cargo.toml" | head -n1)"
pkgrel=1
pkgdesc="Native Nightwave Plaza client with Win98 aesthetic"
arch=('x86_64')
url="https://github.com/PixelMelt/nightwave-plaza-native"
license=('GPL-3.0-or-later')
depends=('alsa-lib' 'dbus')
makedepends=('rust' 'cargo' 'pkgconf')
options=('!lto' '!debug')
\
_reporoot="$startdir/.."

build() {
    cd "$_reporoot"
    cargo build --release --locked
}

package() {
    cd "$_reporoot"
    install -Dm755 "target/release/$pkgname"                       "$pkgdir/usr/bin/$pkgname"
    install -Dm644 "dist/$pkgname.desktop"                         "$pkgdir/usr/share/applications/$pkgname.desktop"
    install -Dm644 "src/assets/icons/$pkgname.png"                 "$pkgdir/usr/share/icons/hicolor/256x256/apps/$pkgname.png"
    install -Dm644 "LICENSE"                                       "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
